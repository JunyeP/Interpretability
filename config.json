    "initial_lambda_mask": 0.0008,
    "final_lambda_mask": 0.0008,
    "initial_lambda_fully_masked": 0.03,
    "final_lambda_fully_masked": 0.03,
    "initial_lambda_alignment": 4,
    "final_lambda_alignment": 4,
    "start_epoch_entropy": 0,
    "initial_lambda_entropy": 0.4,
    "final_lambda_entropy": 0.4,
    "visualization_interval": 1,
    "checkpoint_interval": 5,
    "lambda_entropy": 0.5
